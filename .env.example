# AI Teaching Tool — Environment Variables
# Copy this file to .env and fill in values

# Backend API
API_PORT=8000
DATABASE_URL=sqlite:///data/teaching_tool.db
# For PostgreSQL production: DATABASE_URL=postgresql://user:password@db:5432/teaching_tool

# PostgreSQL (used when DATABASE_URL is PostgreSQL)
DB_USER=teaching_tool
DB_PASSWORD=teaching_tool
DB_NAME=teaching_tool
DB_PORT=5432

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
