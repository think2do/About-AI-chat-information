{
  "$description": "AI Teaching Tool — light editorial redesign tokens. W3C DTCG format; import via Tokens Studio for Figma. Synthesized from mintlify.com, developers.openai.com, perplexity.ai (see design/DESIGN.md).",
  "color": {
    "canvas":        { "$type": "color", "$value": "#FAF9F7", "$description": "Page canvas — never pure white" },
    "surface":       { "$type": "color", "$value": "#FFFFFF", "$description": "Raised card/panel on the warm canvas" },
    "surfaceSubtle": { "$type": "color", "$value": "#F3F1EC", "$description": "Recessed inset — code blocks, detail panels, input fills" },
    "borderSubtle":  { "$type": "color", "$value": "#ECEAE3", "$description": "Faintest divider / hover wash" },
    "border":        { "$type": "color", "$value": "#DEDBD2", "$description": "Card outline, input border, nav separator" },
    "borderStrong":  { "$type": "color", "$value": "#CBC7BC", "$description": "Higher-emphasis structural line" },
    "text": {
      "primary":   { "$type": "color", "$value": "#23211C", "$description": "Body & headings — warm near-black" },
      "secondary": { "$type": "color", "$value": "#57544B", "$description": "Secondary text, inactive nav" },
      "tertiary":  { "$type": "color", "$value": "#86827A", "$description": "Metadata, caption, placeholder" },
      "disabled":  { "$type": "color", "$value": "#ABA79C", "$description": "Disabled / inactive" }
    },
    "brand": {
      "$description": "Marigold yellow from the 旦曼学院 logo (#FEB70C). Use as FILL behind ink text — NEVER as thin text/icons on light surfaces (fails contrast).",
      "yellow":       { "$type": "color", "$value": "#FEB70C", "$description": "Primary brand fill — CTA, active pill, highlight mark, tags (ink text on top)" },
      "yellowStrong": { "$type": "color", "$value": "#E0A200", "$description": "Hover / border on yellow elements" },
      "yellowTint":   { "$type": "color", "$value": "#FEB70C24", "$description": "Faint highlight wash — active-nav background (~14% alpha)" }
    },
    "accent": {
      "link": { "$type": "color", "$value": "#8A5A00", "$description": "Deep amber for the rare branded text link (AA on cream); default links = ink + underline" }
    },
    "cta": {
      "bg":    { "$type": "color", "$value": "#FEB70C", "$description": "Primary action — yellow fill (the logo move)" },
      "text":  { "$type": "color", "$value": "#1A1813", "$description": "Ink text on the yellow button" },
      "hover": { "$type": "color", "$value": "#E0A200", "$description": "Primary button hover" }
    },
    "semantic": {
      "$description": "Content-only: category tags & code syntax. NEVER on UI chrome.",
      "blue":   { "$type": "color", "$value": "#2563EB" },
      "purple": { "$type": "color", "$value": "#7C3AED" },
      "orange": { "$type": "color", "$value": "#B45309" },
      "red":    { "$type": "color", "$value": "#DC2626" },
      "teal":   { "$type": "color", "$value": "#0F766E" }
    }
  },
  "fontFamily": {
    "sans": { "$type": "fontFamily", "$value": "Inter" },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium":  { "$type": "fontWeight", "$value": 500 },
    "semibold":{ "$type": "fontWeight", "$value": 600 }
  },
  "fontSize": {
    "display": { "$type": "dimension", "$value": "36px" },
    "h1":      { "$type": "dimension", "$value": "30px" },
    "h2":      { "$type": "dimension", "$value": "24px" },
    "h3":      { "$type": "dimension", "$value": "18px" },
    "body":    { "$type": "dimension", "$value": "16px" },
    "bodyUI":  { "$type": "dimension", "$value": "14px" },
    "small":   { "$type": "dimension", "$value": "13px" },
    "caption": { "$type": "dimension", "$value": "12px" },
    "eyebrow": { "$type": "dimension", "$value": "12px" },
    "code":    { "$type": "dimension", "$value": "13px" }
  },
  "spacing": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px" },
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "14px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "borderWidth": {
    "hairline": { "$type": "dimension", "$value": "1px" }
  },
  "shadow": {
    "card":    { "$type": "shadow", "$value": { "color": "#23211C0D", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, "$description": "Optional card lift (5% alpha)" },
    "overlay": { "$type": "shadow", "$value": { "color": "#23211C1F", "offsetX": "0px", "offsetY": "8px", "blur": "30px", "spread": "0px" }, "$description": "Modal / popover (12% alpha)" }
  },
  "typography": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.semibold}", "fontSize": "{fontSize.display}", "lineHeight": "1.2",  "letterSpacing": "-0.02em" } },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.semibold}", "fontSize": "{fontSize.h1}",      "lineHeight": "1.25", "letterSpacing": "-0.02em" } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.semibold}", "fontSize": "{fontSize.h2}",      "lineHeight": "1.3",  "letterSpacing": "-0.015em" } },
    "h3":      { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.semibold}", "fontSize": "{fontSize.h3}",      "lineHeight": "1.4",  "letterSpacing": "-0.01em" } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.regular}",  "fontSize": "{fontSize.body}",    "lineHeight": "1.65", "letterSpacing": "-0.006em" } },
    "bodyUI":  { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.regular}",  "fontSize": "{fontSize.bodyUI}",  "lineHeight": "1.5",  "letterSpacing": "-0.004em" } },
    "small":   { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.regular}",  "fontSize": "{fontSize.small}",   "lineHeight": "1.5",  "letterSpacing": "0" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontWeight": "{fontWeight.regular}",  "fontSize": "{fontSize.caption}", "lineHeight": "1.4",  "letterSpacing": "0" } },
    "eyebrow": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontWeight": "{fontWeight.medium}",   "fontSize": "{fontSize.eyebrow}", "lineHeight": "1",    "letterSpacing": "0.06em" } },
    "code":    { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontWeight": "{fontWeight.regular}",  "fontSize": "{fontSize.code}",    "lineHeight": "1.6",  "letterSpacing": "0" } }
  }
}
