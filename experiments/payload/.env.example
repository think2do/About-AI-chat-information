DATABASE_URL=postgresql://payload_local:payload_local_dev_password@127.0.0.1:5432/payload_local
PAYLOAD_SECRET=replace-with-a-long-random-secret
SEED_DEMO_CONTENT=0
NEXT_PUBLIC_SERVER_URL=http://localhost:3020
S3_BUCKET=payload-media
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# 可选；Supabase 公共 bucket 的 URL 前缀，须包含 bucket 名。本地 MinIO 留空。
S3_PUBLIC_URL=
# 仅在生产环境运行 npm run db:seed / db:bootstrap 时提供；不要提交真实值。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=
